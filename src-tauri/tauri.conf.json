{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meister",
  "version": "0.1.0",
  "identifier": "com.meister.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Meister",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/ggml-base.bin",
      "resources/models/ggml-base-encoder.mlmodelc/**/*",
      "resources/ggml-metal.metal"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
